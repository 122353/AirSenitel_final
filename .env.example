# Keep real values only in .env. Never commit them.
OPENAQ_API_KEY=
CPCB_DATA_GOV_API_KEY=
CPCB_DATA_GOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Enable one connector only after its corresponding Google Cloud API, billing,
# security review and credentials are ready.
GEMINI_ENABLED=false
GEMINI_PHOTO_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIREBASE_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=airsentinel
BIGQUERY_LOCATION=asia-south1
EARTH_ENGINE_ENABLED=false
VERTEX_ENABLED=false

# Production access fails closed. Cloud Run also sets K_SERVICE automatically,
# which enables production mode even if AIRSENTINEL_ENV is omitted.
AIRSENTINEL_ENV=local
AIRSENTINEL_AUTH_REQUIRED=false
FIREBASE_AUTH_ENABLED=false
AIRSENTINEL_TRUST_CLOUD_RUN_IAM=false
AIRSENTINEL_CLOUD_RUN_AUTHORITY_ROLE=environment analyst
CITIZEN_REPORTS_REQUIRE_AUTH=false

# Restrict browser-exposed Maps keys by HTTPS referrer and API in GCP Console.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Optional accessibility services. Enable only after consent/retention review.
SPEECH_TO_TEXT_ENABLED=false
TRANSLATION_ENABLED=false
TEXT_TO_SPEECH_ENABLED=false
DIALOGFLOW_AGENT_ID=

# Dashboard mode: 'streamlit' (default) or 'react'
DASHBOARD_MODE=react
REACT_DASHBOARD_PORT=3000
FASTAPI_PORT=8000

# Sensor effective range configuration
# Override default per-pollutant effective prediction radii (in metres)
SENSOR_RANGE_PM25_M=1500
SENSOR_RANGE_PM10_M=2000
SENSOR_RANGE_NO2_M=2000
SENSOR_RANGE_O3_M=3000
SENSOR_RANGE_SO2_M=2000
SENSOR_RANGE_CO_M=1500

# BRICS federation demo endpoints
BRICS_FEDERATION_ENABLED=true
BRICS_DEMO_MODE=true
