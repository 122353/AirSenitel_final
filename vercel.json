{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "dashboard/",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api_service:app",
      "functions": {
        "api_service.py": {
          "maxDuration": 60,
          "includeFiles": "src/**",
          "excludeFiles": "{**/__pycache__/**,**/.env*,**/tests/**,dashboard/**,docs/**,data/**,raw/**,models/**,**/*.pkl,**/*.joblib,**/*.exe,**/*.sqlite*,**/*.db,**/*.zip,.local/**,.venv/**,scripts/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web", "path": "/index.html" } }
  ]
}
