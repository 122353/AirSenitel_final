rules_version = '2';

// Direct client access is intentionally disabled. A future reviewed backend
// integration must use a dedicated service account and explicit IAM, while
// public/citizen access requires a separately reviewed Firebase Auth/App Check
// design. Firebase Admin SDK traffic is governed by IAM, not these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
